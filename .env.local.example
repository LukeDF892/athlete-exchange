# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Restart `npm run dev` after changing these.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses row-level security — never expose this to the browser,
# never commit it, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: how many athletes to list per league (default 140).
INGEST_LIMIT=140
CRON_SECRET=any-long-random-string  # signs /api/cron/* calls
BOT_SECRET=any-long-random-string  # derives bot passwords; rotating it orphans every bot
