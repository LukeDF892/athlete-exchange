{
  "name": "athlete-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "node --experimental-websocket --import tsx scripts/ingest.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:trading": "node --experimental-websocket --import tsx scripts/verify-trading.ts",
    "typecheck": "tsc --noEmit",
    "verify:rls": "node --experimental-websocket --import tsx scripts/verify-rls.ts",
    "reset:market": "node --experimental-websocket --import tsx scripts/reset-market.ts",
    "bots:seed": "node --experimental-websocket --import tsx scripts/seed-bots.ts",
    "verify:shorting": "node --experimental-websocket --import tsx scripts/verify-shorting.ts",
    "reconcile:market": "node --experimental-websocket --import tsx scripts/reconcile-market.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
